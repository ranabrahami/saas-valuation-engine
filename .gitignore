# Virtual environment
.venv/

# Secrets (your SEC User-Agent email lives here)
.env

# Cached/processed data — regenerated by the pipeline, can be large
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Excel outputs: only the outputs/ snapshot is committed, so readers can open the
# models without running anything. Re-running the models overwrites it.
*.xlsx
!outputs/*.xlsx
~$*.xlsx

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# OS / editor
.DS_Store
.vscode/
.idea/
